{
  "name": "eda-document-analyzer",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev-no-turbo": "next dev",
    "build": "next build",
    "build:static": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,json5,md}": [
      "biome check --files-ignore-unknown=true --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "jspdf": "4.2.1",
    "lucide-react": "1.70.0",
    "mammoth": "1.13.0",
    "next": "16.4.5",
    "pdfjs-dist": "6.5.438",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hot-toast": "2.6.1",
    "tailwindcss": "4.3.5",
    "uuid": "14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
